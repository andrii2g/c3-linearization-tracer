{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c3-tracer:hierarchy:v1",
  "title": "C3 hierarchy input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classes"
  ],
  "properties": {
    "target": {
      "$ref": "#/$defs/name"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bases"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "bases": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/name"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    }
  },
  "$comment": "Advisory editor schema. Code must additionally enforce duplicate-property rejection, unique class names, existing references, total edges, byte/depth limits, targets and cycle validation. Schema pattern engines may have newline-anchor differences; the parser must enforce every character explicitly."
}
